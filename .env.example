# PlanetScale Postgres HTTP connection used by the server-only photo API.
DATABASE_URL=postgresql://role.branch:password@host.pg.psdb.cloud:5432/postgres

# Base URL of the deployed Cloudflare media Worker.
MEDIA_BASE_URL=https://alex-sierra-wedding-media.alexjamesgodfrey.workers.dev

# Album exposed by this deployment.
GALLERY_ALBUM_ID=wedding

# SHA-256 hex digest of the shared gallery access code.
GALLERY_ACCESS_CODE_SHA256=

# A random secret of at least 32 characters used only to sign the app's
# authentication cookie. Never configure this value on the media Worker.
GALLERY_SESSION_SECRET=

# A different random secret of at least 32 characters used only for signed
# media URLs. Configure this value as the Worker's MEDIA_SIGNING_SECRET.
MEDIA_SIGNING_SECRET=

# Optional. Host-only cookies are safer and work on localhost and previews.
# Set a domain only if the media Worker later moves to an alexgodfrey.com host.
GALLERY_COOKIE_DOMAIN=

# Optional: signed image URL lifetime. Defaults to six hours.
MEDIA_URL_TTL_SECONDS=21600

# Optional: authenticated session lifetime. Defaults to 30 days.
GALLERY_SESSION_MAX_AGE_SECONDS=2592000
